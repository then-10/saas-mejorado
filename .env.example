# ============================================
# BACKEND CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
ENVIRONMENT=development  # development, staging, production

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_mejorado
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ============================================
# AI & EXTERNAL APIs
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram

# Bot API Configuration
API_BASE_URL=http://localhost:3000/api
API_KEY=your_api_key_here

# ============================================
# WHATSAPP
# ============================================
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
EVOLUTION_API_URL=https://evolution-api.example.com
EVOLUTION_API_KEY=your-evolution-api-key

# ============================================
# CRM INTEGRATIONS
# ============================================
BITRIX24_URL=https://your-domain.bitrix24.com
BITRIX24_WEBHOOK=https://your-domain.bitrix24.com/rest/webhook/
HUBSPOT_API_KEY=your-hubspot-key
PIPEDRIVE_API_KEY=your-pipedrive-key

# ============================================
# n8n AUTOMATION PLATFORM
# ============================================
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your-n8n-key

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@saas-mejorado.com

# ============================================
# AWS S3 CONFIGURATION (OPTIONAL)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=saas-mejorado-bucket

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json

# Bot Logging
BOT_LOG_LEVEL=INFO
BOT_LOG_FILE=bot.log

# ============================================
# SECURITY CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3001
RATES_LIMIT=100
RATES_WINDOW=15

# Rate Limiting for Bot
RATE_LIMIT_MESSAGES_PER_MINUTE=30
MAX_CONVERSATION_HISTORY=50

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_WS_URL=ws://localhost:3000
REACT_APP_ENVIRONMENT=development

# ============================================
# DEBUG MODE
# ============================================
DEBUG=false

