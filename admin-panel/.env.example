# En producción agregar parámetros de pooling para no agotar conexiones de
# Postgres bajo carga (ver `connection_limit`/`pool_timeout` en docs de Prisma):
# postgresql://user:password@host:5432/dbname?connection_limit=5&pool_timeout=10
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_URL="https://your-app.railway.app"
NEXTAUTH_SECRET="your-secret-here"
SHOP_JWT_SECRET=

# E-commerce: cifrado de llaves de pago (AES-256-GCM, generar con `openssl rand -hex 32`)
CIPHER_MASTER_KEY=
# Webhooks de proveedores de pago — registrar URL https://<host>/webhook/{mercadopago,conekta}
MERCADO_PAGO_WEBHOOK_SECRET=
CONEKTA_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL="https://your-app.railway.app"

# WhatsApp (opcional - para notificaciones de venta)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886 # sandbox
STORE_OWNER_WHATSAPP=whatsapp:+521XXXXXXXXXX # número del dueño

# Telegram (opcional - para notificaciones de venta)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cron de expiración de apartados (Fase 4)
CRON_SECRET=
