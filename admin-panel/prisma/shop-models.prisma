// ============================================================
// MÓDULO E-COMMERCE — TiendaRopa (Fase 1)
// Anexar este contenido al final de prisma/schema.prisma
// ============================================================

enum PaymentProviderType {
  MERCADO_PAGO
  CONEKTA
}

enum OrderType {
  PURCHASE
  LAYAWAY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  SPEI
  CASH_OXXO
  CASH_IN_STORE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum LayawayStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Store {
  id                String               @id @default(cuid())
  clientId          String               @unique // tenant: FK al Client existente
  apiKey            String               @unique // X-Tenant-Key que usa la app Android
  name              String
  currency          String               @default("MXN")
  paymentProvider   PaymentProviderType  @default(MERCADO_PAGO)
  mpAccessTokenEnc  String? // cifrado AES-256-GCM (Fase 3)
  conektaKeyEnc     String? // cifrado AES-256-GCM (Fase 3)
  layawayDepositPct Int                  @default(30)
  layawayDays       Int                  @default(30)
  address           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products          Product[]
  customers         Customer[]
  orders            Order[]
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  name        String
  description String      @default("")
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String      @default("")
  category    String      @default("general")
  sizes       String[]    @default([])
  rating      Float       @default(0)
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId, updatedAt])
  @@index([storeId, isActive])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  email        String
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([storeId, email])
}

model Order {
  id           String      @id @default(cuid())
  storeId      String
  customerId   String
  type         OrderType   @default(PURCHASE)
  status       OrderStatus @default(PENDING_PAYMENT)
  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  shippingInfo Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  layaway      Layaway?

  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String // snapshot del producto al momento de la compra
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  size      String   @default("")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id         String               @id @default(cuid())
  orderId    String
  provider   PaymentProviderType?
  method     PaymentMethod
  status     PaymentStatus        @default(PENDING)
  amount     Decimal              @db.Decimal(10, 2)
  externalId String? // id de Mercado Pago / Conekta (Fase 3)
  reference  String? // CLABE SPEI o referencia OXXO (Fase 3)
  expiresAt  DateTime?
  paidAt     DateTime?
  rawWebhook Json?
  createdAt  DateTime             @default(now())
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([externalId])
}

model Layaway {
  id            String        @id @default(cuid())
  orderId       String        @unique
  depositAmount Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @db.Decimal(10, 2) @default(0)
  dueDate       DateTime
  status        LayawayStatus @default(ACTIVE)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
}
