generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum BusinessType {
  RESTAURANTE
  TIENDA_ROPA
  CAFETERIA
  OTRO
}

enum Plan {
  BASICO
  PROFESIONAL
  ENTERPRISE
}

enum ClientStatus {
  ACTIVO
  SUSPENDIDO
  PRUEBA
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         AdminRole     @default(ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model Client {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  businessType BusinessType    @default(OTRO)
  plan         Plan            @default(BASICO)
  status       ClientStatus    @default(PRUEBA)
  contactName  String?
  address      String?
  city         String?
  monthlyLeads Int             @default(0)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  features     ClientFeature[]
  config       ClientConfig?
  store        Store?
}

model ClientConfig {
  id        String   @id @default(cuid())
  clientId  String   @unique
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientFeature {
  id          String    @id @default(cuid())
  clientId    String
  featureKey  String
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, featureKey])
}

model ActivityLog {
  id         String     @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id])
}

// ============================================================
// MÓDULO E-COMMERCE — TiendaRopa (Fase 1)
// Anexar este contenido al final de prisma/schema.prisma
// ============================================================

enum PaymentProviderType {
  MERCADO_PAGO
  CONEKTA
}

enum OrderType {
  PURCHASE
  LAYAWAY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  SPEI
  CASH_OXXO
  CASH_IN_STORE
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum LayawayStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Store {
  id                String               @id @default(cuid())
  clientId          String               @unique // tenant: FK al Client existente
  apiKey            String               @unique // X-Tenant-Key que usa la app Android y el POS web
  name              String
  currency          String               @default("MXN")
  paymentProvider   PaymentProviderType  @default(MERCADO_PAGO)
  mpAccessTokenEnc  String? // cifrado AES-256-GCM (Fase 3)
  conektaKeyEnc     String? // cifrado AES-256-GCM (Fase 3)
  layawayDepositPct Int                  @default(30)
  layawayDays       Int                  @default(30)
  address           String?
  // Add-on App + POS: cargo mensual independiente del Plan del Client
  monthlyPrice      Decimal              @db.Decimal(10, 2) @default(499)
  // Permite al super-admin desactivar el add-on sin borrar datos: la app
  // Android y el POS web dejan de poder operar (X-Tenant-Key rechazado).
  isActive          Boolean              @default(true)
  // Generación de copys con IA para redes sociales (Instagram/TikTok/Facebook) en la app.
  // El costo de las llamadas a la IA corre por cuenta del SaaS bajo el "plan intermedio";
  // el super-admin la activa/desactiva por tienda desde el panel.
  iaMarketingEnabled Boolean             @default(false)
  // Controla si los clientes finales (Customer) pueden registrarse/iniciar sesión
  // con su propia cuenta en la app (en vez de usar las credenciales del dueño).
  // Se administra desde Configuración de la tienda en el panel admin.
  customerAppAccessEnabled Boolean       @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products          Product[]
  customers         Customer[]
  orders            Order[]
  employees         Employee[]
}

enum EmployeeRole {
  OWNER
  STAFF
}

// Cuentas del POS web (dueño/empleados de mostrador), separadas de Customer (comprador final).
model Employee {
  id           String       @id @default(cuid())
  storeId      String
  name         String
  email        String
  passwordHash String
  role         EmployeeRole @default(STAFF)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  name        String
  description String      @default("")
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String      @default("")
  category    String      @default("general")
  sizes       String[]    @default([])
  rating      Float       @default(0)
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  stockMovements StockMovement[]

  @@index([storeId, updatedAt])
  @@index([storeId, isActive])
}

// Historial de ajustes de stock (ventas, cancelaciones, conteos manuales) con razón.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  delta     Int
  reason    String
  note      String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  email        String
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([storeId, email])
}

model Order {
  id           String      @id @default(cuid())
  storeId      String
  customerId   String
  type         OrderType   @default(PURCHASE)
  status       OrderStatus @default(PENDING_PAYMENT)
  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  shippingInfo Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  layaway      Layaway?

  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  name      String // snapshot del producto al momento de la compra
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  size      String   @default("")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id         String               @id @default(cuid())
  orderId    String
  provider   PaymentProviderType?
  method     PaymentMethod
  status     PaymentStatus        @default(PENDING)
  amount     Decimal              @db.Decimal(10, 2)
  externalId String? // id de Mercado Pago / Conekta (Fase 3)
  reference  String? // CLABE SPEI o referencia OXXO (Fase 3)
  expiresAt  DateTime?
  paidAt     DateTime?
  rawWebhook Json?
  createdAt  DateTime             @default(now())
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([externalId])
}

model Layaway {
  id            String        @id @default(cuid())
  orderId       String        @unique
  depositAmount Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @db.Decimal(10, 2) @default(0)
  dueDate       DateTime
  status        LayawayStatus @default(ACTIVE)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
}

